# ─────────────────────────────────────────────────────────────────────────────
# HOMECHEF (SOCIETY CHEF) MONOREPO UNIFIED ENVIRONMENT TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# Save a copy of this file as .env in the respective sub-project workspace directory.
# ─────────────────────────────────────────────────────────────────────────────

# ==========================================
# 1. BACKEND SERVICE CONFIGURATIONS (apps/backend)
# ==========================================
NODE_ENV=production
PORT=8080
JWT_SECRET=placeholder_jwt_secret_minimum_32_chars

# Supabase Configurations
SUPABASE_URL=https://placeholder-project-ref.supabase.co
SUPABASE_ANON_KEY=placeholder_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_private_key

# Payment Gateway — Cashfree (India INR Payments)
CASHFREE_APP_ID=cf_app_placeholder_id
CASHFREE_SECRET_KEY=cf_secret_placeholder_key
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
CASHFREE_RETURN_URL=rasohi://payment-return
CASHFREE_WEBHOOK_URL=https://api.societychef.com/api/v1/payments/cashfree/webhook

# Payment Gateway — Legacy Razorpay (Optional fallback)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Crash Reporting
SENTRY_DSN=https://placeholder-dsn@o0.ingest.sentry.io/0

# ==========================================
# 2. CONSUMER & CHEF MOBILE APP (apps/mobile)
# ==========================================
EXPO_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=placeholder_anon_public_key
EXPO_PUBLIC_GOOGLE_MAPS_KEY=placeholder_google_maps_restricted_api_key
EXPO_PUBLIC_SENTRY_DSN=https://placeholder-dsn@o0.ingest.sentry.io/0

# ==========================================
# 3. DELIVERY PARTNER MOBILE APP (apps/delivery)
# ==========================================
EXPO_PUBLIC_API_URL=https://api.societychef.com/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=placeholder_anon_public_key
EXPO_PUBLIC_GOOGLE_MAPS_KEY=placeholder_google_maps_restricted_api_key

# ==========================================
# 4. OPERATIONS CRM WEB PANEL (apps/ops-web)
# ==========================================
VITE_SUPABASE_URL=https://placeholder-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder_anon_public_key
VITE_API_URL=https://api.societychef.com/api/v1

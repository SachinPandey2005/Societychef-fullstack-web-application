  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "format": "prettier --write \"src/**/*.{js,ts,json}\"",
    "seed:crm": "npx ts-node src/scripts/seed_mock_data.ts",
    "clear:crm": "npx ts-node src/scripts/clear_mock_data.ts",
    "seed:admin": "npx ts-node scripts/bootstrap-admin.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "node --experimental-vm-modules scripts/run-jest.js --watch",
    "test:coverage": "node --experimental-vm-modules scripts/run-jest.js --coverage"
  },
  "keywords": [],

NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Legacy — required by config/env.ts validation but unused by code paths
# already converted to Drizzle/local Postgres. Dummy values are fine unless
# something still depends on the un-converted Supabase-direct call sites
# noted in the Neon migration status.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
# "true" accepts OTP code 123456 for any phone number — local/dev only.
ALLOW_DEV_BYPASS=false

# MSG91 (phone OTP) — optional; without these, a console-log provider is
# used instead so local dev works without a real MSG91 account.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Cloudflare R2 (file storage) — optional; without these, StorageService
# throws only when an upload/delete is actually attempted.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public base URL (R2.dev dev subdomain or a custom domain),
# no trailing slash.
R2_PUBLIC_URL=

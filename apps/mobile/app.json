{
  "expo": {
    "name": "Rasohi",
    "slug": "rasohi",
    "scheme": "rasohi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f3f1ea"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rasohi.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3f1ea"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rasohi.app",
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withReactNativePickerMonorepo.js",
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-video",
      "@sentry/react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RasoHi uses your location to pin your address accurately on the map so chefs and delivery partners can find you."
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7a1515"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "apps/mobile/app"
      },
      "eas": {
        "projectId": "d23f79af-52c3-423b-9429-c1e36d93746b"
      }
    }
  }
}

# HomeChef Environment Configuration Template
# Copy this file to .env in apps/mobile/ to point the app at a live backend.

# Backend API URL
EXPO_PUBLIC_API_URL=https://societychef-1.onrender.com

# Set to 'true' to force the local mock data layer instead of calling the
# real backend above (useful for local UI work without a backend running).
EXPO_PUBLIC_FORCE_MOCK=false

# Sentry crash reporting DSN. Leave blank to disable crash reporting
# (the app runs fine without it, but crashes will be invisible to you).
# Get this from Sentry > Project Settings > Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
